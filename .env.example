# Public app URL (used for absolute links and push). Example: https://saylater.vercel.app
NEXT_PUBLIC_APP_URL=

# Firebase web config (public by design; security comes from Rules + server verification)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only). Paste the service-account private key with \n escapes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Vercel Blob (private store for audio). Added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# AI text-analysis providers (server only). Leave blank to keep a provider unconfigured.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Speech-to-text provider key (server only). Which provider it belongs to is set in STT_PROVIDER.
TRANSCRIPTION_API_KEY=
STT_PROVIDER=openai

# Secret that authorizes cron/queue callers on /api/jobs/* and /api/cron/*
CRON_SECRET=
